{
  "id": "agent-notify",
  "name": "Agent 通知",
  "version": "26.11.20",
  "description": "Claude / ZCode / Codex / Gemini / Kimi 的 Hook 通知与权限审批，以及 Pi / pi-web 的状态提醒，落在桌面小窗",
  "main": "ui.mjs",
  "settings": "settings.mjs",
  "uiFramework": "react",
  "events": [
    "agent-notify",
    "kind:agent-notify",
    "agent-notify.state",
    "agent-notify.permission"
  ],
  "icon": "icon.svg",
  "enabledByDefault": false,
  "sidecar": {
    "command": "node",
    "args": ["runtime/main.mjs"],
    "cwd": "."
  }
}

{
  "id": "agent-notify",
  "name": "Agent 通知",
  "version": "2026.11.06.7",
  "description": "Claude / ZCode / Codex / Gemini / Kimi 的 hook 通知与权限审批，以及 Pi 的 Webhook 状态提醒",
  "main": "ui.mjs",
  "settings": "settings.mjs",
  "events": [
    "agent-notify",
    "kind:agent-notify",
    "agent-notify.state",
    "agent-notify.permission"
  ],
  "icon": "icon.svg",
  "enabledByDefault": false,
  "sidecar": {
    "command": "node",
    "args": ["runtime/main.mjs"],
    "cwd": "."
  }
}

{
  "id": "linuxdo-notify",
  "name": "LINUX DO 通知",
  "version": "0.1.0",
  "description": "轮询 linux.do 通知，活跃时弹出回复/提及等提醒卡片",
  "main": "ui.mjs",
  "background": "background.mjs",
  "settings": "settings.mjs",
  "events": [
    "linuxdo-notify",
    "kind:linuxdo-notify",
    "linuxdo-notify.notification"
  ],
  "enabledByDefault": false,
  "sidecar": {
    "command": "node",
    "args": ["runtime/main.mjs"],
    "cwd": "."
  }
}
